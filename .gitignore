# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# Downloaded and derived data (recreated by scripts; never commit API responses
# that might embed a key). The data/raw/manual folder holds hand-verified inputs
# such as release dates and IS committed.
data/raw/*
!data/raw/.gitkeep
!data/raw/manual/
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# OS
.DS_Store
