# Copy this file to `.env` (which is git-ignored) and fill in your own key.
# Free EIA key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=replace_with_your_eia_key

# Optional. FRED's public CSV endpoint needs no key; a key is only used if you
# switch fred.method to "api" in configs/research_config.yaml.
# Free FRED key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
